<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Requeridos por Electron con Hardened Runtime -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- uiohook-napi (módulo nativo de clics/teclas globales).
       NO se incluye allow-dyld-environment-variables a propósito: reabriría
       DYLD_INSERT_LIBRARIES sobre una app firmada con captura de teclado,
       permitiendo inyectar una dylib maliciosa bajo nuestra identidad. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
