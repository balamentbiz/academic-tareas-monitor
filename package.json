{
  "name": "academic-tareas-monitor",
  "productName": "Academic Tareas Monitor",
  "version": "2.0.0",
  "description": "Monitor de Productividad - Academic Tareas",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac dmg"
  },
  "build": {
    "appId": "com.academictareas.monitor",
    "productName": "Academic Tareas Monitor",
    "copyright": "Academic Tareas",
    "artifactName": "Academic-Tareas-Monitor-${version}-${arch}.${ext}",
    "icon": "assets/icon.icns",
    "files": [
      "main.js",
      "preload.js",
      "preload-overlay.js",
      "renderer/**/*",
      "node_modules/uiohook-napi/**/*"
    ],
    "extraResources": [],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.icns",
      "notarize": false,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "title": "Academic Tareas Monitor",
      "window": {
        "width": 580,
        "height": 420
      },
      "contents": [
        {
          "x": 140,
          "y": 180,
          "type": "file"
        },
        {
          "x": 400,
          "y": 180,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "artifactName": "Academic-Tareas-Monitor-Setup-${version}.${ext}",
      "guid": "A1B2C3D4-E5F6-7890-ABCD-EF1234567890",
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Academic Tareas Monitor",
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "github",
      "owner": "balamentbiz",
      "repo": "academic-tareas-monitor",
      "releaseType": "release"
    },
    "afterSign": null
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "firebase": "^12.14.0",
    "uiohook-napi": "^1.5.5"
  }
}